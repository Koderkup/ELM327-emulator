{
  "name": "elm327-emulator-nxt",
  "version": "1.0.0",
  "description": "ELM327 OBD-II emulator — TypeScript + C++ hybrid (no Python)",
  "license": "CC-BY-NC-SA-4.0",
  "main": "dist/index.js",
  "bin": {
    "elm": "dist/cli/interpreter.js",
    "obd_dictionary": "dist/tools/obd-dictionary.js"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && npm run build:cpp",
    "build:cpp": "cd cpp && node-gyp rebuild --directory=.. 2>/dev/null || (node -e \"require('child_process').execSync('cd cpp && node-gyp configure && node-gyp build', {stdio:'inherit'})\")",
    "build:dev": "tsc --watch",
    "start": "node dist/cli/interpreter.js",
    "test": "node dist/tools/self-test.js",
    "clean": "rm -rf dist build cpp/build"
  },
  "dependencies": {
    "serialport": "^12.0.0",
    "node-pty": "^0.11.5",
    "fast-xml-parser": "^4.3.0",
    "commander": "^12.0.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "node-gyp": "^10.0.0",
    "node-addon-api": "^7.1.0",
    "@types/node": "^20.11.0",
    "@types/commander": "^12.0.0",
    "@types/serialport": "^12.0.0",
    "rimraf": "^6.0.0"
  }
}
